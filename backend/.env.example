ENVIRONMENT=development
# SQLite is only for an easy single-user development preview. Use PostgreSQL for real operations.
DATABASE_URL=sqlite:///./development.db
# DATABASE_URL=postgresql+psycopg://family:CHANGE_ME@localhost:5432/family_ops
FRONTEND_ORIGIN=http://localhost:5173
STORAGE_BACKEND=local
STORAGE_PATH=./private-files
SESSION_HOURS=12
UPLOAD_LIMIT_MB=15
COMPANY_NAME=HAJJAH SITI GLOBAL
# Required only for explicit demo seeding; never set in production.
DEMO_PASSWORD=
# Production object storage (private bucket, no public access).
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Free local OCR; external API fields are unused with FREE_ONLY=true.
OCR_ENDPOINT=
OCR_PROVIDER=local
OCR_API_KEY=
# Optional local Ollama configuration; leave blank for default rule extraction.
EXTRACTION_ENDPOINT=
EXTRACTION_API_KEY=
EXTRACTION_MODEL=

FREE_ONLY=true
EXTRACTION_PROVIDER=rules
BUSINESS_TYPE=Dried seafood

OCR_LANGUAGES=eng
DATABASE_SCHEMA=
INLINE_WORKER=false
FRONTEND_DIST=
S3_SERVER_SIDE_ENCRYPTION=
