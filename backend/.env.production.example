ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://APP_USER:URL_ENCODED_PASSWORD@DATABASE_HOST:5432/family_ops?sslmode=require
FRONTEND_ORIGIN=https://YOUR_SERVICE.onrender.com
STORAGE_BACKEND=s3
S3_BUCKET=business-documents
# Leave empty for AWS S3, or remove this key. Set your HTTPS endpoint for compatible storage.
AWS_DEFAULT_REGION=ap-southeast-1
# Prefer an instance/task IAM role over long-lived keys on AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SESSION_HOURS=12
UPLOAD_LIMIT_MB=15
COMPANY_NAME=HAJJAH SITI GLOBAL
OCR_PROVIDER=gemini
OCR_ENDPOINT=
OCR_API_KEY=
EXTRACTION_ENDPOINT=
EXTRACTION_API_KEY=
EXTRACTION_MODEL=

FREE_ONLY=true
EXTRACTION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Confirm only after checking the Google project is Free tier, billing disabled.
GEMINI_FREE_TIER_CONFIRMED=false
BUSINESS_TYPE=Dried seafood

OCR_LANGUAGES=eng
DATABASE_SCHEMA=hsg_operations
INLINE_WORKER=false
FRONTEND_DIST=
S3_SERVER_SIDE_ENCRYPTION=
S3_ENDPOINT_URL=https://YOUR_PROJECT.storage.supabase.co/storage/v1/s3
# app.launch initial owner, enter privately in hosting secrets:
INITIAL_OWNER_NAME=
INITIAL_OWNER_EMAIL=
INITIAL_OWNER_PASSWORD=
